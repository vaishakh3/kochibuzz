# Server-only. Never expose this with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# Cost controls for the scheduled public-web event scout.
OPENAI_DISCOVERY_MODEL=gpt-5.6-luna
OPENAI_DISCOVERY_REFRESH_HOURS=12
OPENAI_DISCOVERY_MAX_SEARCH_CALLS=4
OPENAI_DISCOVERY_MAX_CANDIDATES=20

# Low-cost structured review for public GitHub submissions.
OPENAI_REVIEW_MODEL=gpt-5.6-luna

# Optional: lets /submit create a GitHub issue without asking visitors to sign in.
GITHUB_SUBMISSIONS_TOKEN=
