{
  "name": "kochibuzz-launch-film",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "capture": "tsx scripts/capture-screens.ts",
    "music": "tsx scripts/generate-music.ts",
    "render": "remotion render src/index.ts KochiBuzzLaunch out/kochibuzz-launch-film.mp4 --codec=h264 --crf=15 --audio-codec=aac --audio-bitrate=320k --pixel-format=yuv420p --overwrite",
    "render:preview": "remotion render src/index.ts KochiBuzzLaunch out/kochibuzz-launch-preview.mp4 --codec=h264 --crf=24 --audio-codec=aac --audio-bitrate=192k --pixel-format=yuv420p --scale=0.5 --overwrite",
    "render:poster": "remotion still src/index.ts KochiBuzzPoster out/kochibuzz-launch-poster.png --overwrite",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/google-fonts": "4.0.515",
    "@remotion/media": "4.0.515",
    "@remotion/transitions": "4.0.515",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0"
  }
}
